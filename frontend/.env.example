NEXT_PUBLIC_ANALYTICA_API_URL=http://localhost:8000

# Development only: upload into the backend's local artifact store without Blob credentials.
ANALYTICA_LOCAL_UPLOADS=true

# Upload signing is fail-closed in production until authentication protects
# the presign route. Do not enable this on a public deployment without auth.
ANALYTICA_UPLOAD_SIGNING_ENABLED=false

# Optional product policy. Keep unset until a maximum upload size is selected.
# MAX_UPLOAD_BYTES=

# Server-only for local signed-upload development. Vercel deployments can use OIDC/store integration.
# BLOB_READ_WRITE_TOKEN=
