# Public URL of the deployed FastAPI project. Required in production.
NEXT_PUBLIC_ANALYTICA_API_URL=http://localhost:8000

# Upload signing is intentionally fail-closed in production until authentication
# is implemented. Enable only in a controlled deployment during this milestone.
ANALYTICA_UPLOAD_SIGNING_ENABLED=false

# Optional product upload-size policy in bytes. Leave unset until product policy
# is selected. Each presigned URL is still constrained to the declared file size.
# ANALYTICA_MAX_UPLOAD_BYTES=1073741824

# Connect this frontend Vercel project to the same private Blob store as the
# backend project. Vercel supplies Blob/OIDC environment values automatically.
