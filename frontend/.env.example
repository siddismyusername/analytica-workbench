# Public FastAPI project URL. Required in production.
NEXT_PUBLIC_ANALYTICA_API_URL=http://localhost:8000

# Fail-closed guard until the authentication milestone protects upload signing.
ANALYTICA_UPLOAD_SIGNING_ENABLED=false

# Optional product upload-size policy in bytes. Keep aligned with MAX_UPLOAD_BYTES
# in the backend when a product limit is selected.
# ANALYTICA_MAX_UPLOAD_BYTES=1073741824

# Connect this Vercel project and the backend project to the same private Blob store.
