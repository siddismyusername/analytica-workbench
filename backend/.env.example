# Runtime mode: development, test, or production.
ENVIRONMENT=development

# Exact browser origins allowed to call the API directly, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keep conservative on serverless compute; benchmark before increasing.
DUCKDB_THREADS=1

# PostgreSQL in production. SQLite is only the local-development default.
DATABASE_URL=sqlite+pysqlite:///./analytica.db

# Use "vercel_blob" in deployed environments connected to a private Blob store.
ARTIFACT_STORE_BACKEND=local
LOCAL_ARTIFACT_ROOT=.analytica/artifacts

# Vercel Blob supplies this automatically when the store is connected.
# BLOB_READ_WRITE_TOKEN=
