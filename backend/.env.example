# Runtime mode: development, test, or production.
ENVIRONMENT=development

# Exact browser origins allowed to call the API directly, comma-separated.
# Example: https://app.example.com,https://analytica-workbench.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keep conservative on serverless compute; benchmark before increasing.
DUCKDB_THREADS=1

# PostgreSQL in production. SQLite is only the local-development default.
DATABASE_URL=sqlite+pysqlite:///./analytica.db

# local for development/tests; vercel_blob in the deployed backend project.
ARTIFACT_STORE_PROVIDER=local
LOCAL_ARTIFACT_ROOT=.analytica/artifacts

# inline executes ingestion in-process for local development/tests.
# Set to vercel in production to publish durable dataset-ingestion messages.
QUEUE_PROVIDER=inline

# Product policy: leave unset until an explicit upload-size limit is chosen.
# When set, the backend rejects an uploaded object larger than this value.
# MAX_UPLOAD_BYTES=1073741824

# Hard safety ceiling for preview responses, independent of UI page size.
PREVIEW_MAX_ROWS=200
