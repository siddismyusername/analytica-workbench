ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
DUCKDB_THREADS=1

# PostgreSQL in production. SQLite is the local-development default only.
DATABASE_URL=sqlite+pysqlite:///./analytica.db

# Local for tests/development, including the development-only upload endpoint.
# Use vercel_blob in the deployed backend.
ARTIFACT_STORE_BACKEND=local
LOCAL_ARTIFACT_ROOT=.analytica/artifacts

# Inline executes through the same worker contract locally; use vercel in production.
QUEUE_PROVIDER=inline

# Optional product policy. Leave unset until benchmark/product limits are decided.
# MAX_UPLOAD_BYTES=

# Connected Vercel Blob stores/OIDC provide production credentials. For local Blob testing:
# BLOB_READ_WRITE_TOKEN=
